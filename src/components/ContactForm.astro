---
interface Props {
  /** Unique id suffix for this form instance — required when multiple forms appear on one page */
  formId?: string;
  /** Compact mode: tighter spacing for hero placement */
  compact?: boolean;
  /** Pre-tick a service checkbox by value (e.g. 'gutter_cleaning') */
  preselectedService?: string;
  /** Optional override for the submit button label */
  submitLabel?: string;
}

const { formId = 'contact', compact = false, preselectedService, submitLabel = 'Get My Free Quote' } = Astro.props;

const fid = (suffix: string) => `${suffix}-${formId}`;

const services = [
  { value: 'gutter_cleaning', label: 'Gutter Cleaning' },
  { value: 'roof_scraping', label: 'Roof Moss Removal (Scraping)' },
  { value: 'roof_pressure', label: 'Roof Pressure Washing' },
  { value: 'driveway', label: 'Driveway/Patio Cleaning' },
  { value: 'soffit_fascia', label: 'Soffit & Fascia Washing' },
  { value: 'conservatory_roof', label: 'Conservatory Roof Washing' },
  { value: 'solar_panels', label: 'Solar Panel Washing' },
  { value: 'other', label: 'Other Services' },
];

// In compact mode we tighten vertical rhythm for hero placement
const fieldSpacing = compact ? 'space-y-4' : 'space-y-6';
const fieldGridGap = compact ? 'gap-3' : 'gap-5';
const inputPadding = compact ? 'px-3.5 py-2.5' : 'px-4 py-3';
const labelMargin = compact ? 'mb-1' : 'mb-1.5';
const buttonPadding = compact ? 'py-3' : 'py-4';
---

<form id={fid('contact-form')} class={fieldSpacing} data-form-instance={formId}>
  <!-- Hidden attribution fields -->
  <input type="hidden" name="gclid" id={fid('gclid')} />
  <input type="hidden" name="source" id={fid('source')} />
  <input type="hidden" name="landing_page" id={fid('landing_page')} />
  <input type="hidden" name="referrer" id={fid('referrer')} />
  <input type="hidden" name="utm_source" id={fid('utm_source')} />
  <input type="hidden" name="utm_medium" id={fid('utm_medium')} />
  <input type="hidden" name="utm_campaign" id={fid('utm_campaign')} />
  <input type="hidden" name="utm_term" id={fid('utm_term')} />
  <!-- form_variant lets the backend distinguish hero-inline vs full /contact submissions -->
  <input type="hidden" name="form_variant" value={compact ? 'inline' : 'standard'} />

  <!-- Name -->
  <div class={`grid grid-cols-1 sm:grid-cols-2 ${fieldGridGap}`}>
    <div>
      <label for={fid('first_name')} class={`block text-sm font-medium text-gray-700 ${labelMargin}`}>First Name <span class="text-red-500">*</span></label>
      <input
        type="text"
        id={fid('first_name')}
        name="first_name"
        required
        autocomplete="given-name"
        class={`w-full bg-white border-2 border-gray-200 rounded-xl ${inputPadding} text-gray-900 placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors duration-200`}
      />
    </div>
    <div>
      <label for={fid('last_name')} class={`block text-sm font-medium text-gray-700 ${labelMargin}`}>Last Name <span class="text-red-500">*</span></label>
      <input
        type="text"
        id={fid('last_name')}
        name="last_name"
        required
        autocomplete="family-name"
        class={`w-full bg-white border-2 border-gray-200 rounded-xl ${inputPadding} text-gray-900 placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors duration-200`}
      />
    </div>
  </div>

  <!-- Email & Phone -->
  <div class={`grid grid-cols-1 sm:grid-cols-2 ${fieldGridGap}`}>
    <div>
      <label for={fid('email')} class={`block text-sm font-medium text-gray-700 ${labelMargin}`}>Email <span class="text-red-500">*</span></label>
      <input
        type="email"
        id={fid('email')}
        name="email"
        required
        autocomplete="email"
        inputmode="email"
        class={`w-full bg-white border-2 border-gray-200 rounded-xl ${inputPadding} text-gray-900 placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors duration-200`}
      />
    </div>
    <div>
      <label for={fid('phone')} class={`block text-sm font-medium text-gray-700 ${labelMargin}`}>Phone <span class="text-red-500">*</span></label>
      <input
        type="tel"
        id={fid('phone')}
        name="phone"
        required
        autocomplete="tel"
        inputmode="tel"
        placeholder="07xxx xxxxxx"
        class={`w-full bg-white border-2 border-gray-200 rounded-xl ${inputPadding} text-gray-900 placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors duration-200`}
      />
    </div>
  </div>

  <!-- Address -->
  <div>
    <label for={fid('address')} class={`block text-sm font-medium text-gray-700 ${labelMargin}`}>Street Address <span class="text-red-500">*</span></label>
    <input
      type="text"
      id={fid('address')}
      name="address"
      required
      autocomplete="street-address"
      placeholder="e.g. 14 High Street"
      class={`w-full bg-white border-2 border-gray-200 rounded-xl ${inputPadding} text-gray-900 placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors duration-200`}
    />
  </div>

  <!-- Town & Postcode -->
  <div class={`grid grid-cols-1 sm:grid-cols-2 ${fieldGridGap}`}>
    <div>
      <label for={fid('address_city')} class={`block text-sm font-medium text-gray-700 ${labelMargin}`}>Town <span class="text-red-500">*</span></label>
      <input
        type="text"
        id={fid('address_city')}
        name="address_city"
        required
        autocomplete="address-level2"
        placeholder="e.g. Tring"
        class={`w-full bg-white border-2 border-gray-200 rounded-xl ${inputPadding} text-gray-900 placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors duration-200`}
      />
    </div>
    <div>
      <label for={fid('postcode')} class={`block text-sm font-medium text-gray-700 ${labelMargin}`}>Postcode <span class="text-red-500">*</span></label>
      <input
        type="text"
        id={fid('postcode')}
        name="postcode"
        required
        autocomplete="postal-code"
        autocapitalize="characters"
        placeholder="e.g. HP23 4AB"
        class={`w-full bg-white border-2 border-gray-200 rounded-xl ${inputPadding} text-gray-900 placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors duration-200`}
      />
    </div>
  </div>

  <!-- Services Checkboxes -->
  <div>
    <label class={`block text-sm font-medium text-gray-700 ${compact ? 'mb-2' : 'mb-3'}`}>Services Needed</label>
    <div class={`grid grid-cols-1 sm:grid-cols-2 ${compact ? 'gap-2' : 'gap-3'}`}>
      {services.map(s => (
        <label class="flex items-center gap-3 cursor-pointer group">
          <input
            type="checkbox"
            name="services"
            value={s.value}
            checked={preselectedService === s.value}
            class="w-5 h-5 rounded border-2 border-gray-300 text-sky-500 focus:ring-sky-500 focus:ring-offset-0 accent-sky-500 flex-shrink-0"
          />
          <span class="text-gray-700 text-sm group-hover:text-sky-600 transition-colors">{s.label}</span>
        </label>
      ))}
    </div>
  </div>

  <!-- Message (hidden in compact mode unless user expands) -->
  {!compact && (
    <div>
      <label for={fid('message')} class={`block text-sm font-medium text-gray-700 ${labelMargin}`}>Additional Details</label>
      <textarea
        id={fid('message')}
        name="message"
        rows="4"
        placeholder="Tell us about your property, any specific requirements, or questions you have..."
        class={`w-full bg-white border-2 border-gray-200 rounded-xl ${inputPadding} text-gray-900 placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors duration-200 resize-none`}
      ></textarea>
    </div>
  )}
  {compact && (
    <details class="group">
      <summary class="cursor-pointer text-sm text-sky-600 hover:text-sky-700 font-medium select-none list-none flex items-center gap-2">
        <span class="inline-block transition-transform group-open:rotate-90">▸</span>
        Add notes (optional)
      </summary>
      <div class="mt-2">
        <textarea
          id={fid('message')}
          name="message"
          rows="3"
          placeholder="Tell us about your property, any specific requirements, or questions you have..."
          class={`w-full bg-white border-2 border-gray-200 rounded-xl ${inputPadding} text-gray-900 placeholder-gray-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors duration-200 resize-none`}
        ></textarea>
      </div>
    </details>
  )}

  <!-- Success message -->
  <div id={fid('form-success')} class="hidden bg-sky-50 border border-sky-200 text-sky-800 text-sm px-4 py-3 rounded-xl text-center font-medium">
    Thank you! Your request has been submitted. We'll get back to you with a quote shortly. Please note that during periods of heavy rainfall we experience a surge of requests and may take slightly longer than usual to respond.
  </div>

  <!-- Error message -->
  <div id={fid('form-error')} class="hidden bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-xl text-center">
    Something went wrong. Please try again or call us on <a href="tel:07904621160" class="underline font-medium">07904621160</a>.
  </div>

  <button
    type="submit"
    id={fid('submit-btn')}
    class={`w-full bg-sky-500 hover:bg-sky-600 text-white ${buttonPadding} rounded-full font-semibold text-lg transition-all duration-200 shadow-lg shadow-sky-500/25 hover:shadow-sky-500/40 hover:-translate-y-0.5 disabled:opacity-70 disabled:cursor-not-allowed disabled:hover:translate-y-0`}
  >
    <span id={fid('submit-text')}>{submitLabel}</span>
    <span id={fid('submit-loading')} class="hidden">Submitting...</span>
  </button>

  <p class="text-gray-500 text-xs text-center">
    We respond within 24 hours. Your details are kept confidential.<br />
    Minimum job value £75 (inc. VAT). Callout, travel and setup included in every quote.
  </p>
</form>

<script>
  // ─── Attribution Capture (shared across all form instances on the page) ─
  function getUrlParam(name: string): string | null {
    return new URLSearchParams(window.location.search).get(name);
  }

  // ─── Experiment bucketing ─────────────────────────────────────────
  // Stable visitor bucket assigned on first visit, persisted in localStorage.
  // While EXPERIMENT_ACTIVE is false, every visitor reports as 'inline-only'
  // (rolling out to 100% of traffic). When we want to A/B test a future
  // change, flip EXPERIMENT_ACTIVE to true and split traffic by bucket.
  const EXPERIMENT_ACTIVE = false;
  const EXPERIMENT_NAME = 'inline-form-v1';

  function getOrAssignBucket(): string {
    try {
      const key = `gb_exp_${EXPERIMENT_NAME}`;
      let bucket = localStorage.getItem(key);
      if (!bucket) {
        const id = (crypto?.randomUUID?.() || String(Math.random())).replace(/-/g, '');
        let h = 0;
        for (let i = 0; i < id.length; i++) {
          h = ((h << 5) - h) + id.charCodeAt(i);
          h |= 0;
        }
        bucket = (Math.abs(h) % 2 === 0) ? 'A' : 'B';
        localStorage.setItem(key, bucket);
      }
      return EXPERIMENT_ACTIVE ? bucket : 'inline-only';
    } catch {
      return 'inline-only';
    }
  }

  function initAttribution() {
    const gclidParam = getUrlParam('gclid');
    if (gclidParam) localStorage.setItem('gclid', gclidParam);
    const gclid = gclidParam || localStorage.getItem('gclid') || '';

    let source = 'direct';
    if (gclid) source = 'google_ads';
    else if (getUrlParam('utm_source')) source = getUrlParam('utm_source')!;
    else if (document.referrer && !document.referrer.includes('gutterbugs.co.uk')) source = 'organic';

    const utmSrc = getUrlParam('utm_source') || '';
    const utmMed = getUrlParam('utm_medium') || '';
    const utmCmp = getUrlParam('utm_campaign') || '';
    const utmTrm = getUrlParam('utm_term') || '';
    const arm = getOrAssignBucket();

    // Populate every form instance on the page
    document.querySelectorAll<HTMLFormElement>('form[data-form-instance]').forEach(form => {
      const set = (selector: string, val: string) => {
        const el = form.querySelector<HTMLInputElement>(selector);
        if (el) el.value = val;
      };
      set('input[name="gclid"]', gclid);
      set('input[name="source"]', source);
      set('input[name="referrer"]', document.referrer || '');
      set('input[name="landing_page"]', window.location.href);
      set('input[name="utm_source"]', utmSrc);
      set('input[name="utm_medium"]', utmMed);
      set('input[name="utm_campaign"]', utmCmp);
      set('input[name="utm_term"]', utmTrm);
      set('input[name="experiment_arm"]', arm);
    });
  }

  // ─── Form Submission (per-instance handler) ─────────────────────────────
  function bindForm(form: HTMLFormElement) {
    const id = form.dataset.formInstance!;
    const submitBtn = document.getElementById(`submit-btn-${id}`) as HTMLButtonElement;
    const submitText = document.getElementById(`submit-text-${id}`)!;
    const submitLoading = document.getElementById(`submit-loading-${id}`)!;
    const errorDiv = document.getElementById(`form-error-${id}`)!;
    const successDiv = document.getElementById(`form-success-${id}`)!;

    // form_start event — fires on first focus into any field of THIS form, once per page load.
    // Used to measure abandonment (form_start vs form_complete events).
    let formStartFired = false;
    const variant = form.querySelector<HTMLInputElement>('input[name="form_variant"]')?.value || 'standard';
    form.addEventListener('focusin', () => {
      if (formStartFired) return;
      formStartFired = true;
      if (typeof gtag !== 'undefined') {
        const arm = form.querySelector<HTMLInputElement>('input[name="experiment_arm"]')?.value || 'inline-only';
        gtag('event', 'form_start', {
          event_category: 'form',
          event_label: variant,
          form_variant: variant,
          experiment_arm: arm,
        });
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitText.classList.add('hidden');
      submitLoading.classList.remove('hidden');
      errorDiv.classList.add('hidden');
      successDiv.classList.add('hidden');

      const formData = new FormData(form);
      const data: Record<string, string | null> = {};
      formData.forEach((value, key) => {
        if (key !== 'services') data[key] = value.toString();
      });

      const checkedServices = Array.from(
        form.querySelectorAll('input[name="services"]:checked')
      ).map((cb) => (cb as HTMLInputElement).value);
      data.service_type = checkedServices.length > 0 ? checkedServices.join(',') : null;

      if (typeof gtag !== 'undefined') {
        gtag('event', 'Contact_Us_Form_Entry', {
          event_category: 'form',
          event_label: data.service_type || 'unspecified',
          form_variant: data.form_variant || 'standard',
          experiment_arm: data.experiment_arm || 'inline-only',
        });
        gtag('event', 'form_complete', {
          event_category: 'form',
          event_label: data.form_variant || 'standard',
          form_variant: data.form_variant || 'standard',
          experiment_arm: data.experiment_arm || 'inline-only',
        });
        gtag('event', 'generate_lead', {
          currency: 'GBP',
          value: 0,
          form_variant: data.form_variant || 'standard',
          experiment_arm: data.experiment_arm || 'inline-only',
        });
      }

      try {
        const endpoint = (import.meta as any).env?.PUBLIC_FORM_ENDPOINT || 'https://gutterbugs-form.ryan-1f9.workers.dev';
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        // Parse JSON defensively — worker always returns JSON, but a transient
        // network blip or a Cloudflare error page could return non-JSON. If the
        // response isn't parseable, we still treat a 2xx as success (the lead
        // was almost certainly saved server-side before the response came back).
        let result: any = null;
        try {
          result = await response.json();
        } catch {
          // Non-JSON response — if status is 2xx, treat as success; otherwise fail
          if (response.ok) {
            successDiv.classList.remove('hidden');
            form.reset();
            setTimeout(() => {
              window.location.href = '/thank-you';
            }, 1500);
            return;
          }
          throw new Error('Server error');
        }

        if (response.ok) {
          successDiv.classList.remove('hidden');
          form.reset();
          setTimeout(() => {
            window.location.href = '/thank-you';
          }, 1500);
        } else {
          throw new Error(result?.error || 'Server error');
        }
      } catch {
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitText.classList.remove('hidden');
        submitLoading.classList.add('hidden');
      }
    });
  }

  declare function gtag(...args: any[]): void;

  initAttribution();
  document.querySelectorAll<HTMLFormElement>('form[data-form-instance]').forEach(bindForm);
</script>
